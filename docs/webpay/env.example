# Documentación de configuración. No copiar secretos reales a este archivo.
# La validación definitiva vive en src/lib/env/server.ts.

# URL canónica exacta, sin slash final.
APP_URL=http://localhost:4173

# Interruptor para crear nuevos checkouts. Los callbacks y la reconciliación
# deben seguir funcionando aunque este valor sea false.
PAYMENTS_ENABLED=false

# Valores permitidos: integration | production
TRANSBANK_ENVIRONMENT=integration

# Vercel la inyecta sólo en Preview cuando existe un Protection Bypass for
# Automation. Es obligatoria para crear transacciones Integration protegidas.
# No copiarla a Production ni usar x-vercel-set-bypass-cookie.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Obligatoria si se habilita integration en un despliegue con NODE_ENV=production.
# Hasta 20 correos de prueba controlados, separados por coma.
SANDBOX_BUYER_EMAIL_ALLOWLIST=

# En integration se usan las constantes públicas del SDK oficial.
# Configurar estos valores únicamente en Vercel Production después de la
# validación de Transbank. Nunca usar prefijo NEXT_PUBLIC.
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY_SECRET=

# Timeout explícito para create, commit y status del SDK.
TRANSBANK_TIMEOUT_MS=8000

# La moneda y los totales se determinan en backend. No existe precio/tarifa
# fija en variables del navegador.
ORDER_CURRENCY=CLP

# Reserva inicial para piezas únicas; validar en sandbox.
INVENTORY_RESERVATION_MINUTES=15

# Valor POR CAJA, deliberado sólo para una prueba aislada con sandbox_fixed.
# No es una tarifa real y no tiene valor predeterminado.
SANDBOX_SHIPPING_CLP=

# Las dimensiones actuales ya están cargadas; mantener false.
ALLOW_INCOMPLETE_SHIPPING_IN_SANDBOX=false

# Secreto aleatorio de al menos 32 caracteres para hashear claves del rate
# limit. Generarlo localmente; no copiar el valor a documentación o chat.
CHECKOUT_RATE_LIMIT_SECRET=

# Validación server-side del domicilio. Para la primera prueba Webpay puede
# permanecer false; antes de cobros productivos debe estar habilitada.
ADDRESS_VALIDATION_ENABLED=false
ADDRESS_PROVIDER=google
GOOGLE_MAPS_SERVER_API_KEY=
ADDRESS_VALIDATION_SIGNING_SECRET=
ADDRESS_PROVIDER_TIMEOUT_MS=5000

# Valores implementados: table | sandbox_fixed. Usar table normalmente.
SHIPPING_RATE_SOURCE=table

# Solo backend; vacías mientras SHIPPING_RATE_SOURCE=table.
CHILEXPRESS_API_KEY=

# Solo backend. Usar valores diferentes por ambiente.
SUPABASE_SERVICE_ROLE_KEY=

# Secretos distintos para cada job. Nunca reutilizarlos.
RECONCILIATION_JOB_SECRET=
OUTBOX_JOB_SECRET=

# Rate limit distribuido para acciones administrativas destructivas.
ADMIN_ACTION_RATE_LIMIT_SECRET=

# Los refunds permanecen apagados hasta completar MFA y sandbox.
REFUNDS_ENABLED=false
REFUNDS_REQUIRE_AAL2=true
REFUND_RECENT_SESSION_MINUTES=30

# Destino de confirmaciones operativas y alertas financieras.
COMMERCE_ALERT_EMAIL=

# Proveedor server-side para confirmaciones y alertas del outbox.
RESEND_API_KEY=
EMAIL_FROM=ReSkiChile <noreply@reskichile.cl>

# Identificador del destino durable de logs/alertas, si el proveedor lo exige.
# Su valor sensible también debe vivir solo en variables server-side.
OBSERVABILITY_DSN=
